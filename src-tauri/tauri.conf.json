{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "天楽 Galgame 翻译器",
  "version": "0.3.0",
  "identifier": "com.tianle.galgame-dialogue-translator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "天楽 Galgame 翻译器",
        "width": 1480,
        "height": 980,
        "minWidth": 1100,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "translation-overlay",
        "url": "overlay.html",
        "title": "天楽 翻译字幕",
        "width": 820,
        "height": 140,
        "minWidth": 280,
        "minHeight": 80,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "contentProtected": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "../translator_cli.py",
      "../realtime_game_translator.py",
      "../requirements.txt"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
