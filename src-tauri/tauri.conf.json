{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galgame Dialogue Translator",
  "version": "0.1.0",
  "identifier": "com.tianle.galgame-dialogue-translator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Game Dialogue Translator",
        "width": 1480,
        "height": 980,
        "minWidth": 1100,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../translator_cli.py",
      "../realtime_game_translator.py",
      "../requirements.txt"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
